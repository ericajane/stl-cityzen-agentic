# Mock values for the agent container. Copy this file to `.env.agent`
# (gitignored, sits next to the real .env) and it gets bind-mounted over
# /workspace/.env at container start — so the agent never sees your real
# CSB_API_KEY or JWT_SECRET, and can't accidentally leak them in a commit,
# a log, or a test file it writes.
#
# None of the app's existing tests hit the live CSB API or verify a real
# JWT signature against a specific secret, so dummy values are sufficient
# for build/lint/test tasks. If a future task genuinely needs the real key
# (e.g. testing the live /sync endpoint), that's a deliberate, separate
# decision — not the default.

CSB_API_KEY=dev-mock-key-not-real
CSB_API_BASE_URL=https://www.stlouis-mo.gov/powernap/stlouis/api.cfm
DATA_YEAR_FROM=2025

JWT_SECRET=dev-only-secret-do-not-use-in-prod
JWT_EXPIRES_IN=1h
